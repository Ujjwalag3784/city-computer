# dependencies
node_modules/
.pnp/
.pnp.js

# testing
coverage/

# next.js
.next/
out/
next-env.d.ts

# production
# Not `/build` at the repo root only — this is meant for a top-level build
# output directory, but a bare `build/` pattern matches *any* directory
# named "build" anywhere in the tree, which also swallows the real,
# intentional PC Builder route source at `src/app/[locale]/(storefront)/build/`.
# The two negations below carve that specific source path back out.
build/
!src/app/**/build/
!src/app/**/build/**
dist/

# env
.env
.env.local
.env.*.local

# misc
.DS_Store
*.pem
*.log
.turbo/

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma
prisma/**/*.db

# generated Prisma client (Prisma 7 requires a custom `output`, see
# prisma/schema/schema.prisma) — regenerated by `pnpm db:generate`, never committed
src/generated/

# ide
.vscode/*
!.vscode/extensions.json
.idea/

# stray lock/tmp artifacts from filesystem sync tooling
_tmp_*

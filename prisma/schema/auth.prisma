// Identity & access — docs/06-DATA-MODEL.md §3.
// User, Account, Session, VerificationToken (Auth.js v5, database session
// strategy so admin sessions can be revoked server-side), Role, Permission,
// RolePermission, UserRole, Customer, Address.

// TODO(raw-sql): CHECK (email IS NOT NULL OR phone IS NOT NULL) on `users`.
// See docs/06-DATA-MODEL.md §12 #7. Collected in prisma/sql/manual-constraints.sql.
model User {
  id               String     @id @default(cuid(2))
  email            String?    @unique
  emailVerified    DateTime?  @map("email_verified")
  phone            String?    @unique
  phoneVerified    DateTime?  @map("phone_verified")
  /// Argon2id. Null for OAuth-only accounts.
  passwordHash     String?    @map("password_hash")
  name             String?
  image            String?
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?  @map("last_login_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  /// Encrypted at rest at the application layer; required for admin roles.
  twoFactorSecret  String?    @map("two_factor_secret")
  preferredLocale  Locale     @default(EN) @map("preferred_locale")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Every relation below is the only relation between User and that target
  // model, so no explicit `@relation` name is required (Prisma pairs them
  // automatically). The single genuinely ambiguous case — Refund has two
  // separate FKs to User (requestedById, approvedById) — is named on both
  // sides down in commerce.prisma.
  accounts            Account[]
  sessions            Session[]
  userRoles           UserRole[]
  customer            Customer?
  uploadedMedia       Media[]
  stockMovementsActed StockMovement[]
  orderStatusEvents   OrderStatusEvent[]
  paymentsApproved    Payment[]
  refundsRequested    Refund[]           @relation("RefundRequestedBy")
  refundsApproved     Refund[]           @relation("RefundApprovedBy")
  assignedTickets     ServiceTicket[]
  ticketEvents        TicketEvent[]
  auditLogs           AuditLog[]
  assignedEnquiries   Enquiry[]
  priceChanges        PriceHistory[]
  authorProfile       Author?

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid(2))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  id          String   @id @default(cuid(2))
  /// OWNER | MANAGER | STAFF | CONTENT_EDITOR | SUPPORT | TECHNICIAN | CUSTOMER
  /// Stored as data (not a Prisma enum) so an OWNER can create custom roles
  /// without a deploy, per docs/06 §3 — the seeded set is just the starting data.
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid(2))
  /// `resource:action` string, e.g. `product:create`, `order:refund`.
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid(2))
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid(2))
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// 1:1 with User for registered customers; standalone rows exist for guest
/// orders (userId null).
model Customer {
  id               String    @id @default(cuid(2))
  userId           String?   @unique @map("user_id")
  email            String?
  phone            String?
  name             String?
  defaultAddressId String?   @unique @map("default_address_id")
  totalOrders      Int       @default(0) @map("total_orders")
  totalSpentPaisa  Int       @default(0) @map("total_spent_paisa")
  lastOrderAt      DateTime? @map("last_order_at")
  /// e.g. `wholesale`, `cod-blocked`.
  tags             String[]
  codBlocked       Boolean   @default(false) @map("cod_blocked")
  /// Internal, admin-only.
  notes            String?   @db.Text
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  defaultAddress  Address?          @relation("CustomerDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  addresses       Address[]         @relation("CustomerAddresses")
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  couponRedemptions CouponRedemption[]
  builds          Build[]
  serviceTickets  ServiceTicket[]
  abandonedCarts  AbandonedCart[]
  builderSessions BuilderSession[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

/// Nepal has no reliable postal-code system in practice — there is
/// deliberately no postcode field. `landmark` is effectively required.
model Address {
  id              String        @id @default(cuid(2))
  customerId      String        @map("customer_id")
  fullName        String        @map("full_name")
  phone           String
  alternatePhone  String?       @map("alternate_phone")
  province        Province
  district        String
  municipality    String
  ward            Int?
  streetAddress   String        @map("street_address")
  landmark        String?
  latitude        Float?
  longitude       Float?
  label           AddressLabel  @default(HOME)
  isDefault       Boolean       @default(false) @map("is_default")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer         Customer  @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)
  defaultForCustomer Customer? @relation("CustomerDefaultAddress")

  @@index([customerId])
  @@map("addresses")
}

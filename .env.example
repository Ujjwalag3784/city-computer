# Copy to .env.local and fill in real values. See docs/03-TECHNOLOGY-STACK.md §5.
# Never commit a file with real secrets.

# --- Core ---
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://citycomputer:citycomputer@localhost:5432/citycomputer
DIRECT_DATABASE_URL=postgresql://citycomputer:citycomputer@localhost:5432/citycomputer

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (MinIO locally, R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=citycomputer-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
NEXT_PUBLIC_CDN_URL=http://localhost:9000/citycomputer-media

# --- Email ---
RESEND_API_KEY=
MAIL_FROM=orders@citycomputer.com.np
MAIL_FROM_TRANSACTIONAL=orders@citycomputer.com.np
MAIL_REPLY_TO=support@citycomputer.com.np

# --- Payments (sandbox values — see docs/10-PAYMENTS-NEPAL.md) ---
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=
CONNECTIPS_MERCHANT_ID=
